{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "weather-sandbox-save-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-09",
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "7712401",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_RATE_LIMITER",
      "namespace_id": "7712402",
      "simple": {
        "limit": 3,
        "period": 60
      }
    }
  ],
}
